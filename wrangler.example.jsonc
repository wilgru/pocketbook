{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketbook",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pocketbook-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle",
    },
  ],
  // Cloudflare Access — restricts the app to members of this Cloudflare account.
  // The Access application is created in Zero Trust > Access > Applications.
  // After creating it, replace the placeholder values below with your real ones.
  "access": {
    // dev block: simulates an authenticated user when running `wrangler dev` locally.
    // Remove this block (or the whole "access" key) to simulate an unauthenticated request locally.
    "dev": {
      "aud": "pocketbook-dev",
      "identity": {
        "email": "dev@example.com",
        "name": "Dev User",
      },
    },
  },
}
