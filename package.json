{
  "name": "pocketbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "npm run build && npm run db:migrate:cloud && wrangler deploy --config dist/server/wrangler.json",
    "db:seed": "npx tsx scripts/seedDevDb.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:cloud": "wrangler d1 migrations apply DB --remote --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "test": "echo 'No test runner specified'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "@lexical/code": "^0.48.0",
    "@lexical/link": "^0.48.0",
    "@lexical/list": "^0.48.0",
    "@lexical/markdown": "^0.48.0",
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "jotai": "^2.20.2",
    "lexical": "^0.48.0",
    "match-sorter": "^8.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@types/debounce": "^1.2.4",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.7.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
